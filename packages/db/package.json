{
  "name": "@meterpilot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --packages external",
    "db:check": "bun --env-file=.env x drizzle-kit check",
    "db:generate": "bun --env-file=.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env x drizzle-kit migrate",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meterpilot/config": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4"
  }
}
