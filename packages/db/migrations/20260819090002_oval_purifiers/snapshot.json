    },
    {
      "value": "length(trim(\"resource_type\")) > 0",
      "name": "audit_log_resource_type_not_empty_check",
      "entityType": "checks",
      "schema": "public",
      "table": "audit_log"
    },
    {
      "value": "(\n        (\"actor_type\" = 'system' and \"actor_user_id\" is null and \"actor_api_key_id\" is null)\n        or (\"actor_type\" = 'user' and \"actor_user_id\" is not null and \"actor_api_key_id\" is null)\n        or (\"actor_type\" = 'api_key' and \"actor_user_id\" is null and \"actor_api_key_id\" is not null)\n      )",
      "name": "audit_log_actor_shape_check",
      "entityType": "checks",
      "schema": "public",
      "table": "audit_log"
    },
    {
      "value": "\"prefix\" ~ '^[A-Za-z0-9][A-Za-z0-9._:-]*$'",
      "name": "api_keys_prefix_format_check",
      "entityType": "checks",
      "schema": "public",
      "table": "api_keys"
    },
    {
      "value": "length(\"secret_hash\") >= 32",
      "name": "api_keys_secret_hash_length_check",
      "entityType": "checks",
      "schema": "public",
      "table": "api_keys"
    },
    {
      "value": "cardinality(\"scopes\") > 0 and array_position(\"scopes\", null) is null and array_position(\"scopes\", '') is null",
      "name": "api_keys_scopes_not_empty_check",
      "entityType": "checks",
      "schema": "public",
      "table": "api_keys"
    },
    {
      "value": "\"last_used_at\" is null or \"last_used_at\" >= \"created_at\"",
      "name": "api_keys_last_used_at_check",
      "entityType": "checks",
      "schema": "public",
      "table": "api_keys"
    },
    {
      "value": "\"expires_at\" is null or \"expires_at\" > \"created_at\"",
      "name": "api_keys_expires_at_check",
      "entityType": "checks",
      "schema": "public",
      "table": "api_keys"
    },
    {
      "value": "\"revoked_at\" is null or \"revoked_at\" >= \"created_at\"",
      "name": "api_keys_revoked_at_check",
      "entityType": "checks",
      "schema": "public",
      "table": "api_keys"
    },
    {
      "value": "\"slug\" ~ '^[a-z0-9]+(?:-[a-z0-9]+)*$'",
      "name": "organizations_slug_format_check",
      "entityType": "checks",
      "schema": "public",
      "table": "organizations"
    },
    {
      "value": "length(trim(\"name\")) > 0",
