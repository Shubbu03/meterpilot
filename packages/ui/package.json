{
  "name": "@meterpilot/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/globals.css"
  },
  "scripts": {
    "build": "bun run build:code && bun run build:styles",
    "build:code": "bun build src/index.ts --outdir dist --target browser --packages external",
    "build:styles": "tailwindcss --input src/globals.css --output dist/globals.css --minify",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
