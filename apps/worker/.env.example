# Worker-local runtime configuration.
DATABASE_URL=postgresql://meterpilot:meterpilot_local@127.0.0.1:5432/meterpilot
JOB_CLAIM_LIMIT=10
JOB_LEASE_DURATION_MS=60000
JOB_MAX_ATTEMPTS=8
JOB_POLL_INTERVAL_MS=1000
JOB_RETRY_BASE_DELAY_MS=1000
JOB_RETRY_MAX_DELAY_MS=300000
LOG_LEVEL=info
NODE_ENV=development
